{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SucculentGarden: Generate Project",
      "type": "process",
      "command": "xcodegen",
      "args": ["generate"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "SucculentGarden: Build",
      "type": "process",
      "command": "xcodebuild",
      "args": [
        "-project", "${workspaceFolder}/SucculentGarden.xcodeproj",
        "-scheme", "SucculentGarden",
        "-configuration", "Debug",
        "-destination", "platform=macOS",
        "-derivedDataPath", "${workspaceFolder}/build",
        "-jobs", "1",
        "build"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "SucculentGarden: Run",
      "type": "process",
      "command": "open",
      "args": ["-n", "${workspaceFolder}/build/Build/Products/Debug/多肉花园.app"],
      "dependsOn": "SucculentGarden: Build",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
